<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="repository.aniaddon" name="AniAddon Repository" version="1.0.0" provider-name="TeamAniAddon">
    <extension point="xbmc.addon.repository" name="AniAddon Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/nitubhaskar/AniAddon/main/repo/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/nitubhaskar/AniAddon/main/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/nitubhaskar/AniAddon/main/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>AniAddon Repository</summary>
        <description>Repository for AniAddon anime streaming and context menu addons.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="context.aniaddon" version="6.0.0" name="AniAddon - Global Context Menu Items" provider-name="TeamAniAddon">
  <requires>
     <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="default.py" args="findrecommendations">
        <label>Find Recommendations</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.findrecommendations),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="findrelations">
        <label>Find Relations</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.findrelations),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="getwatchorder">
        <label>Get Watch Order</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.getwatchorder),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="viewreviews">
        <label>View Reviews</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.viewreviews),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="viewstatistics">
        <label>View Statistics</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.viewstatistics),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="markedaswatched">
        <label>Marked as Watched [COLOR blue]WatchList[/COLOR]</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.markedaswatched),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,episode) | String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
      </item>
      <item library="default.py" args="rescrape">
        <label>Rescrape</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.rescrape),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,episode)|String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
      </item>
      <item library="default.py" args="sourceselect">
        <label>Source Select</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.sourceselect),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,episode)|String.IsEqual(ListItem.DBTYPE,movie)] + !Player.HasMedia</visible>
      </item>
      <item library="default.py" args="logout">
        <label>Logout</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.logout),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + String.Contains(ListItem.folderpath,/watchlist/)</visible>
      </item>
      <item library="default.py" args="deletefromdatabase">
        <label>Delete From Database</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.deletefromdatabase),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="watchlist">
        <label>WatchList Manager</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.watchlist),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/) + [String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
      <item library="default.py" args="fanartselect">
        <label>Select Fanart</label>
        <visible>String.IsEqual(Window(home).Property(context.aniaddon.fanartselect),true) + String.StartsWith(ListItem.Path,plugin://plugin.video.aniaddon/)+[String.IsEqual(ListItem.DBTYPE,tvshow)|String.IsEqual(ListItem.DBTYPE,movie)]</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en">AniAddon - Global Context Menu Items</summary>
    <description lang="en">Adds Global Contextual Menu Items for AniAddon menu items throughout Kodi
    </description>
    <platform>all</platform>
    <license>GPL-3.0</license>
    <forum></forum>
    <website></website>
    <source></source>
    <disclaimer lang="en"></disclaimer>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
      <clearlogo>logo.png</clearlogo>
      <poster>poster.png</poster>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.aniaddon" name="AniAddon" provider-name="TeamAniAddon" version="6.0.0">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.module.beautifulsoup4"/>
    <import addon="script.module.inputstreamhelper"/>
    <import addon="script.module.pyqrcode"/>
    <import addon="context.aniaddon" version="6.0.0"/>
  </requires>
  <extension library="default.py" point="xbmc.python.pluginsource">
        <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <reuselanguageinvoker>false</reuselanguageinvoker> <!-- You can enable this if you want, expect some instability but much faster menu speeds -->
    <summary lang="en">AniAddon video plugin</summary>
    <description lang="en">AniAddon is a provider based, streaming software that is tightly
            interwoven with MAL. AniAddon provides the freedom to view media from a single menu system from service
            providers of the users choosing. Please Note: We do not host, create, or distribute any of the content displayed in the addon.
    </description>
    <platform>all</platform>
    <disclaimer>AniAddon is and always will be free and open-source. None of its code and resources may be sold or redistributed for any commercial purposes.[CR]This addon and its developers [B]DO NOT[/B] host, create, or distribute any of the content displayed in the addon, it simply scrapes ad financed public websites. It is the responsibility of the user to ensure that they are following all applicable laws and regulations in their country.[CR]This addon and its developers are not in any way affiliated with Team Kodi or any of the sites and providers used in the addon.</disclaimer>
    <license>GPL-3.0</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
      <clearlogo>logo.png</clearlogo>
      <poster>poster.png</poster>
      <screenshot>resources/screenshots/screenshot-01.jpg</screenshot>
      <screenshot>resources/screenshots/screenshot-02.jpg</screenshot>
      <screenshot>resources/screenshots/screenshot-03.jpg</screenshot>
      <screenshot>resources/screenshots/screenshot-04.jpg</screenshot>
    </assets>
  </extension>
</addon></addons>
